# Copy to .env.local. SQLite database files live in ./data (gitignored).
DATABASE_PATH=./data/webring.db
# Test databases are deleted and rebuilt on every run; the names must end in
# .test.db / .e2e.db (the reset script refuses anything else).
TEST_DATABASE_PATH=./data/webring.test.db
E2E_DATABASE_PATH=./data/webring.e2e.db

# Admin area (needed for /admin and `npm run admin:create`).
# BETTER_AUTH_SECRET: signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The only account allowed into /admin. Also the email `npm run admin:create` uses.
ADMIN_EMAIL=
# Production: set SITE_URL to your https address so the session cookie is Secure.
# SITE_URL=https://your-ring.example
# Extra origins allowed to sign in, comma-separated (e.g. a LAN address while developing).
# TRUSTED_ORIGINS=http://192.168.8.8:3001

# Join form. All optional.
# APPLICATIONS_OPEN=false        # stop accepting applications (checked on every submit)
# TRUST_PROXY=true               # only if the app sits behind a proxy you control
# MAX_PENDING_APPLICATIONS=100
