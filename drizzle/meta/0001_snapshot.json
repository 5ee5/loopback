      "checkConstraints": {
        "members_id_format": {
          "name": "members_id_format",
          "value": "length(\"members\".\"id\") BETWEEN 1 AND 64 AND \"members\".\"id\" NOT GLOB '*[^A-Za-z0-9_-]*'"
        },
        "members_url_http": {
          "name": "members_url_http",
          "value": "(\"members\".\"url\" LIKE 'http://_%' OR \"members\".\"url\" LIKE 'https://_%') AND length(\"members\".\"url\") <= 2048 AND instr(\"members\".\"url\", ' ') = 0 AND instr(\"members\".\"url\", char(9)) = 0 AND instr(\"members\".\"url\", char(10)) = 0 AND instr(\"members\".\"url\", char(13)) = 0"
        },
        "members_name_length": {
          "name": "members_name_length",
          "value": "length(trim(\"members\".\"display_name\")) BETWEEN 1 AND 60"
        },
        "members_description_length": {
          "name": "members_description_length",
          "value": "length(\"members\".\"description\") <= 160"
        },
        "members_joined_at": {
          "name": "members_joined_at",
          "value": "\"members\".\"joined_at\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND coalesce(date(\"members\".\"joined_at\") = \"members\".\"joined_at\", 0)"
        },
        "members_status_valid": {
          "name": "members_status_valid",
          "value": "\"members\".\"status\" IN ('active', 'inactive', 'suspended')"
        },
        "members_tags": {
          "name": "members_tags",
          "value": "json_valid(\"members\".\"tags\") AND json_type(\"members\".\"tags\") = 'array' AND json_array_length(\"members\".\"tags\") <= 5"
        },
        "members_accent_hex": {
          "name": "members_accent_hex",
          "value": "\"members\".\"accent_color\" IS NULL OR (length(\"members\".\"accent_color\") = 7 AND \"members\".\"accent_color\" GLOB '#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]')"
        },
        "members_avatar_https": {
          "name": "members_avatar_https",
          "value": "\"members\".\"avatar_url\" IS NULL OR (\"members\".\"avatar_url\" LIKE 'https://_%' AND length(\"members\".\"avatar_url\") <= 2048 AND instr(\"members\".\"avatar_url\", ' ') = 0)"
        }
      }
