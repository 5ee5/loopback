      "checkConstraints": {
        "applications_url_http": {
          "name": "applications_url_http",
          "value": "(\"applications\".\"url\" LIKE 'http://_%' OR \"applications\".\"url\" LIKE 'https://_%') AND length(\"applications\".\"url\") <= 2048 AND instr(\"applications\".\"url\", ' ') = 0 AND instr(\"applications\".\"url\", char(9)) = 0 AND instr(\"applications\".\"url\", char(10)) = 0 AND instr(\"applications\".\"url\", char(13)) = 0"
        },
        "applications_name_length": {
          "name": "applications_name_length",
          "value": "length(trim(\"applications\".\"display_name\")) BETWEEN 1 AND 60"
        },
        "applications_description_length": {
          "name": "applications_description_length",
          "value": "length(\"applications\".\"description\") <= 160"
        },
        "applications_tags": {
          "name": "applications_tags",
          "value": "json_valid(\"applications\".\"tags\") AND json_type(\"applications\".\"tags\") = 'array' AND json_array_length(\"applications\".\"tags\") <= 5"
        },
        "applications_status_valid": {
          "name": "applications_status_valid",
          "value": "\"applications\".\"status\" IN ('pending', 'approved', 'rejected')"
        },
        "applications_email": {
          "name": "applications_email",
          "value": "\"applications\".\"contact_email\" IS NULL OR (length(\"applications\".\"contact_email\") BETWEEN 3 AND 254 AND instr(\"applications\".\"contact_email\", ' ') = 0 AND instr(\"applications\".\"contact_email\", '@') > 1 AND instr(substr(\"applications\".\"contact_email\", instr(\"applications\".\"contact_email\", '@') + 1), '@') = 0 AND instr(substr(\"applications\".\"contact_email\", instr(\"applications\".\"contact_email\", '@') + 1), '.') > 1)"
        },
        "applications_pending_has_email": {
          "name": "applications_pending_has_email",
          "value": "\"applications\".\"status\" <> 'pending' OR \"applications\".\"contact_email\" IS NOT NULL"
        },
        "applications_decided_consistency": {
          "name": "applications_decided_consistency",
          "value": "(\"applications\".\"status\" = 'pending' AND \"applications\".\"decided_at\" IS NULL) OR (\"applications\".\"status\" <> 'pending' AND \"applications\".\"decided_at\" IS NOT NULL)"
        }
      }
